# Coinnect Health Check backend environment example
#
# Copy this file to .env for local use:
#   Copy-Item .env.example .env

# Required. Change this before using a real kiosk.
HEALTHCHECK_PIN=123456

# Allows healthcheck_api to import the shared Coinnect backend package.
PYTHONPATH=../../backend

# Safe development defaults. These do not touch real serial ports, GPIO, or camera.
USE_MOCK_SERIAL=true
USE_MOCK_HARDWARE=true
MOCK_DELAY=0
SERIAL_PORT_BILL=MOCK_BILL
SERIAL_PORT_COIN=MOCK_COIN

LOG_LEVEL=INFO

# PayMongo-only e-wallet sandbox diagnostics.
# The healthcheck refuses to create sessions unless sandbox mode, test keys,
# webhook verification, source account details, and an HTTPS public URL are
# configured. This flow never accepts or dispenses physical cash.
PAYMONGO_API_URL=https://api.paymongo.com
PAYMONGO_SANDBOX=true
# Test keys from PayMongo Dashboard > Developers/API Keys.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Secret generated for the test-mode payment.paid webhook endpoint.
PAYMONGO_WEBHOOK_SECRET=
# Source account values attached to the PayMongo Money Movement wallet.
PAYMONGO_SOURCE_ACCOUNT_NUMBER=
PAYMONGO_SOURCE_ACCOUNT_NAME=Coinnect
PAYMONGO_SOURCE_ACCOUNT_BIC=PAEYPHM2XXX
PAYMONGO_TIMEOUT_SECONDS=15
PAYMONGO_MAX_RETRIES=3

# Public HTTPS origin for this healthcheck backend. The application derives:
#   payment webhook: /api/v1/ewallet-sandbox/callbacks/payment
#   transfer callback: /api/v1/ewallet-sandbox/callbacks/transfer
# Register only the payment URL as a test-mode PayMongo dashboard webhook and
# subscribe it to payment.paid. The transfer URL is embedded in transfer calls.
HEALTHCHECK_PUBLIC_BASE_URL=https://healthcheck.example.com

# Separate diagnostics persistence. Production coinnect.db is never used.
HEALTHCHECK_EWALLET_DB_URL=sqlite+aiosqlite:///./healthcheck_ewallet.db
HEALTHCHECK_EWALLET_TIMEOUT_SECONDS=600
HEALTHCHECK_EWALLET_RETENTION_LIMIT=100

# Camera and bill ML diagnostics.
# Live image tests use CAMERA_DEVICE plus the YOLO model paths below.
# Static model tests verify that each configured file exists, loads with
# Ultralytics YOLO, and exposes the expected class labels.
CAMERA_DEVICE=0
YOLO_AUTH_MODEL_PATH=../../backend/models/auth.pt
YOLO_DENOM_MODEL_PATH=../../backend/models/denom.pt
YOLO_AUTH_MODEL_PATH_USD=../../backend/models/auth_usd.pt
YOLO_DENOM_MODEL_PATH_USD=../../backend/models/denom_usd.pt
YOLO_AUTH_MODEL_PATH_EUR=../../backend/models/auth_eur.pt
YOLO_DENOM_MODEL_PATH_EUR=../../backend/models/denom_eur.pt
YOLO_CONFIDENCE_THRESHOLD=0.7

# Bill acceptor live-flow diagnostics.
# These tests use entry IR detection, timed conveyor positioning, and, for
# accepted bills, sort/store the bill.
BILL_PULL_SPEED=60
BILL_EJECT_SPEED=80
BILL_STORE_SPEED=70
LED_STABILIZATION_DELAY=0.2
BILL_ACCEPTANCE_TIMEOUT=10
BILL_PULL_DURATION=1.5
BILL_STORE_DURATION=2.0
BILL_EJECT_DURATION=1.5
STORAGE_SLOT_CAPACITY=100

# Frontend origins allowed to call this diagnostics API.
# Private LAN origins on ports 5174 and 4174 are also allowed by default, so
# http://192.168.x.x:5174 and http://coinnect.local:5174 work for remote
# browser access when the frontend is served from the Raspberry Pi.
HEALTHCHECK_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174
# Override only if you need a custom host or port.
# HEALTHCHECK_CORS_ORIGIN_REGEX=^https?://192\.168\.1\.50:5174$

# Paperang P1 printer healthcheck.
# PAPERANG_MAC_ADDRESS skips Bluetooth discovery when known.
# PAPERANG_REPO_PATH is resolved from the repository root when relative.
# PAPERANG_DENSITY is optional; leave unset to keep printer default.
PAPERANG_MAC_ADDRESS=
PAPERANG_REPO_PATH=vendor/python-paperang
PAPERANG_FEED_LINES=120
PAPERANG_PRINT_TIMEOUT_SECONDS=60

# Real Raspberry Pi / Arduino example:
# USE_MOCK_SERIAL=false
# USE_MOCK_HARDWARE=false
# SERIAL_PORT_BILL=/dev/coinnect_bill
# SERIAL_PORT_COIN=/dev/coinnect_coin
# CAMERA_DEVICE=0
# YOLO_AUTH_MODEL_PATH=../../backend/models/auth.pt
# YOLO_DENOM_MODEL_PATH=../../backend/models/denom.pt
# YOLO_AUTH_MODEL_PATH_USD=../../backend/models/auth_usd.pt
# YOLO_DENOM_MODEL_PATH_USD=../../backend/models/denom_usd.pt
# YOLO_AUTH_MODEL_PATH_EUR=../../backend/models/auth_eur.pt
# YOLO_DENOM_MODEL_PATH_EUR=../../backend/models/denom_eur.pt
# LOG_LEVEL=INFO

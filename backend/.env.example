# Coinnect Backend Environment Configuration
# Copy this file to .env and configure with your actual values.
# Do not commit .env to version control.

# ============================================================================
# SERIAL PORT CONFIGURATION
# ============================================================================

# Arduino Mega #1 - Bill Controller (sorting + dispensing)
# Use symlink for reliability (created by udev rules): /dev/coinnect_bill
# Or use direct device path: /dev/ttyUSB0
SERIAL_PORT_BILL=/dev/coinnect_bill

# Arduino Mega #2 - Coin & Security Controller
# Use symlink for reliability (created by udev rules): /dev/coinnect_coin
# Or use direct device path: /dev/ttyACM0
SERIAL_PORT_COIN=/dev/coinnect_coin

# Serial baud rate (must match firmware settings)
BAUD_RATE=115200

# Serial timeout in seconds
SERIAL_TIMEOUT=5

# Maximum time to wait for each Arduino READY event after opening its port.
# Opening USB serial resets most Arduino boards, so production commands must
# not be sent until firmware setup has completed.
SERIAL_READY_TIMEOUT=8

# Pace coin-controller commands so UUID-bearing JSON cannot overflow the
# Arduino Uno's 64-byte hardware serial receive ring while RFID is polling.
COIN_SERIAL_WRITE_CHUNK_SIZE=16
COIN_SERIAL_WRITE_CHUNK_DELAY=0.02
COIN_SERIAL_RESYNC_DELAY=0.05

# Use mock serial ports for testing without hardware
USE_MOCK_SERIAL=false

# Mock delay for simulating hardware operations (in seconds)
MOCK_DELAY=1.0

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Customer APIs run locally on the Raspberry Pi. Expose only the signed webhook.
HOST=127.0.0.1

# FastAPI server port
PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application environment: development, staging, production
ENVIRONMENT=production

# Enable API documentation (Swagger UI)
# Set to false in production for security
ENABLE_DOCS=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# HARDWARE, CAMERA, AND ML CONFIGURATION
# ============================================================================

# Use mock hardware for development without camera/GPIO/Arduino devices
USE_MOCK_HARDWARE=false

# Inventory reconciliation policy. When false, reconciliation problems are
# recorded as alerts/claims but do not prevent later payout attempts. Set true
# to require operator reconciliation before any further cash dispensing.
BLOCK_DISPENSING_ON_INVENTORY_INCONSISTENCY=false

# USB camera device index (usually 0 for first camera)
# Legacy name CAMERA_INDEX is still accepted.
CAMERA_DEVICE=0

# White LED brightness (PWM duty cycle %, 0 to 100)
WHITE_LED_BRIGHTNESS=100

# YOLO model paths
# Legacy name YOLO_MODEL_PATH is still accepted for YOLO_AUTH_MODEL_PATH.
YOLO_AUTH_MODEL_PATH=models/auth.pt
YOLO_DENOM_MODEL_PATH=models/denom.pt
YOLO_CONFIDENCE_THRESHOLD=0.7

# Currency-specific YOLO model paths
YOLO_AUTH_MODEL_PATH_USD=models/auth_usd.pt
YOLO_DENOM_MODEL_PATH_USD=models/denom_usd.pt
YOLO_AUTH_MODEL_PATH_EUR=models/auth_eur.pt
YOLO_DENOM_MODEL_PATH_EUR=models/denom_eur.pt

# Bill acceptor motor speeds (PWM duty cycle %)
BILL_PULL_SPEED=60
BILL_EJECT_SPEED=80
BILL_STORE_SPEED=70

# Bill acceptor timing (seconds)
LED_STABILIZATION_DELAY=0.2
# Calibrated forward motor run time from entry IR detection to camera position.
BILL_PULL_DURATION=1.5
BILL_STORE_DURATION=2.0
BILL_EJECT_DURATION=1.5

# Hardware timeouts (seconds)
BILL_ACCEPTANCE_TIMEOUT=10
SORTING_MOVE_TIMEOUT=8
DISPENSE_TIMEOUT=5
COIN_DISPENSE_TIMEOUT=3

# Storage and inventory thresholds
STORAGE_SLOT_CAPACITY=100
LOW_BILL_THRESHOLD=10
LOW_COIN_THRESHOLD=50

# Transaction session timeout (seconds)
SESSION_TIMEOUT=180

ADMIN_SESSION_MINUTES=15
ADMIN_LOCKOUT_MINUTES=5
ADMIN_MAX_ATTEMPTS=5

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLAlchemy async database URL
DB_URL=sqlite+aiosqlite:///./coinnect.db

# ============================================================================
# FOREX CONFIGURATION
# ============================================================================

# FOREX_API_KEY is not required for Frankfurter API
FOREX_API_KEY=
FOREX_API_URL=https://api.frankfurter.dev/v1/latest
FOREX_CACHE_TTL_SECONDS=86400
FOREX_RATE_REFRESH_INTERVAL=3600

# Forex fees (percentage per currency pair)
FOREX_FEE_USD_TO_PHP=5.0
FOREX_FEE_PHP_TO_USD=5.0
FOREX_FEE_EUR_TO_PHP=5.0
FOREX_FEE_PHP_TO_EUR=5.0

# Forex connectivity checks
FOREX_CONNECTIVITY_CHECK_URL=https://api.frankfurter.dev
FOREX_CONNECTIVITY_TIMEOUT=5

# ============================================================================
# PAYMONGO E-WALLET CONFIGURATION
# ============================================================================
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_URL=https://api.paymongo.com
PAYMONGO_SANDBOX=true
PAYMONGO_TIMEOUT_SECONDS=15
PAYMONGO_MAX_RETRIES=3
PAYMONGO_WEBHOOK_LEASE_SECONDS=60
PAYMONGO_WEBHOOK_FAST_RETRY_SECONDS=[1,5,30,120,300]
PAYMONGO_WEBHOOK_RECONCILIATION_INTERVAL_SECONDS=3600
# Register https://example.com/api/v1/ewallet/webhook in PayMongo Test/Live Mode webhooks dashboard.
# Subscribe to: payment.paid, transfer.outward.successful, and transfer.outward.failed.
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
PAYMONGO_SOURCE_ACCOUNT_NUMBER=
PAYMONGO_SOURCE_ACCOUNT_NAME=Coinnect
PAYMONGO_SOURCE_ACCOUNT_BIC=PAEYPHM2XXX
EWALLET_FEE_TIERS=[{"min":1,"max":500,"fee":15},{"min":501,"max":null,"fee":25}]
# Set calibrated maximum counts for PHP_1, PHP_5, PHP_10, PHP_20 tubes.
# Empty limits disable real e-wallet coin intake; safe bill paths remain usable.
COIN_STORAGE_CAPACITIES={}

# ============================================================================
# PAPERANG RECEIPT PRINTER
# ============================================================================
# Enable receipt printing (true/false)
PAPERANG_ENABLED=false
# Optional printer Bluetooth MAC address to avoid discovery delays
PAPERANG_MAC_ADDRESS=
# Path to the Paperang support repository
PAPERANG_REPO_PATH=vendor/python-paperang
# Print density settings (optional)
PAPERANG_DENSITY=
# Number of empty feed lines post-print
PAPERANG_FEED_LINES=120
# Print timeout in seconds
PAPERANG_PRINT_TIMEOUT_SECONDS=60

# ============================================================================
# MAINTENANCE ACCESS CONFIGURATION
# ============================================================================
# Comma-separated list of authorized RFID card UIDs
ADMIN_RFID_UIDS=

# ============================================================================
# ARDUINO SORTER SLOT CONFIGURATION (Calibrated Step Count Positions)
# ============================================================================
SLOT_1_POSITION=0
SLOT_2_POSITION=30000
SLOT_3_POSITION=60000
SLOT_4_POSITION=90000
SLOT_5_POSITION=122500
SLOT_6_POSITION=153500
SLOT_7_POSITION=187500
SLOT_8_POSITION=219500
